[audio]
# Audio sample rate in Hz (standard for OBS/Discord)
sample_rate = 48000

# Buffer frame size (smaller = less latency, higher = fewer audio dropouts)
block_size = 1024

# Channel count (2 = stereo)
channels = 2

# Queue buffer size (~10 blocks prevents latency drift and memory buildup)
queue_maxsize = 10


[pulse_sinks]
# Virtual sink name where OBS sends its monitor audio
obs_input_name = OBS_Input

# Display label for the OBS input sink in volume mixers (pavucontrol)
obs_input_description = OBS_Input

# Virtual sink name where Discord/Vesktop listens for input
audio_output_name = Audio_Stream_Output

# Display label for the output sink in volume mixers
audio_output_description = Audio_Stream_Output


[pulse_properties]
# Application identifier shown under pavucontrol's Playback tab
app_name = Audio_Bridge_Primary

# Stream/media name shown under pavucontrol's Playback tab
media_name = Audio_Bridge_Primary