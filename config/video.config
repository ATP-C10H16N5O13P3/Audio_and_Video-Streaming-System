[camera]
# 0 = prompt to select, or enter specific integer
bus = 0
device = 0
# Desired capture dimensions
width = 1920
height = 1080
# MMAP driver buffers in kernel memory
num_buffers = 4
# Buffer read timeout in seconds
timeout = 2.0
# Seconds to wait between reconnect checks
reconnect_poll_interval = 0.7

[recording]
# Directory to store captures
output_base_dir = recordings
# Prefix for session folders
dir_prefix = capture_
# Filename for raw MJPEG stream
video_filename = video.mjpeg
# Filename for hardware V4L2 timestamps
timestamps_filename = timestamps.txt

[display]
# Default playback delay in seconds
initial_delay_sec = 2.0
# Minimum playback delay limit
min_delay_sec = 0.0
# Maximum playback delay limit
max_delay_sec = 10.0
# Delay adjustment step for +/- keys
delay_step_sec = 0.5
# Max decoded BGR frames kept in RAM (~6MB per 1080p frame)
max_buffer_frames = 1000
# Launch without window borders (toggle with 'B')
start_borderless = true
# Launch in fullscreen mode (toggle with 'F')
start_fullscreen = false
# Suppress noisy Qt/Wayland debug messages
qt_logging_rules = qt.qpa.wayland*=false;*.debug=false

[encoding]
# 'cfr' (fixed fps for NLE editors) or 'vfr' (native timestamps for media players)
mode = cfr
# Output rate when mode = cfr (higher = less quantization drift)
target_fps = 60
# H.264 quality scale (17-18 visually lossless, 23 standard)
crf = 18
# CPU speed/compression balance (ultrafast to veryslow)
preset = fast
# Pixel format for broad editor/player support
pixel_format = yuv420p
# Final rendered output filename
output_filename = output_synced.mp4